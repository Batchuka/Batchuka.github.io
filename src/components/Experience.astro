---
/* 01 Experiência: um bloco por entrada de src/content/experience/<idioma>/, com cartões numerados. */
import { getCollection } from 'astro:content';
import { home } from '../data/home';
import { getLangFromUrl } from '../i18n/ui';
import { inline } from '../utils/inline';
import Gallery from './Gallery.astro';
import Fiscal from './diagrams/Fiscal.astro';
import Plataforma from './diagrams/Plataforma.astro';
import Pytrobot from './diagrams/Pytrobot.astro';
import SectionHead from './SectionHead.astro';

const lang = getLangFromUrl(Astro.url);
const copy = home[lang].experience;
const entries = (
	await getCollection('experience', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft)
).sort((a, b) => a.data.order - b.data.order);
const pad = (n: number) => String(n).padStart(2, '0');

/* Ícones dos ganhos nos itens de destaque: traço em 24 x 24, na cor de destaque. */
const gainIcons: Record<string, string> = {
	person: 'M 12 4 a 3.5 3.5 0 1 0 0.01 0 Z M 5 20 c 0 -4 3 -6.5 7 -6.5 s 7 2.5 7 6.5',
	clock: 'M 12 3 a 9 9 0 1 0 0.01 0 Z M 12 7 V 12 L 15.5 14',
	unlock: 'M 6 11 H 18 V 20 H 6 Z M 9 11 V 7.5 a 3 3 0 0 1 6 0 M 12 14.5 V 16.5',
	bot: 'M 5 9 H 19 V 19 H 5 Z M 12 9 V 5 M 10.5 4.5 H 13.5 M 9 13 V 14 M 15 13 V 14 M 9.5 16.5 H 14.5',
	deploy: 'M 12 20 V 6 M 7 11 L 12 6 L 17 11 M 5 3.5 H 19',
	standard: 'M 4 4 H 10 V 10 H 4 Z M 14 4 H 20 V 10 H 14 Z M 4 14 H 10 V 20 H 4 Z M 14 14 H 20 V 20 H 14 Z',
	doc: 'M 6 3 H 14 L 19 8 V 21 H 6 Z M 14 3 V 8 H 19 M 9 12 H 16 M 9 15.5 H 16 M 9 19 H 13',
	bell: 'M 6 17 V 11 a 6 6 0 0 1 12 0 V 17 L 19.5 18.5 H 4.5 Z M 10 21 H 14',
	spark: 'M 12 3 Q 13 11 21 12 Q 13 13 12 21 Q 11 13 3 12 Q 11 11 12 3 Z',
	bolt: 'M 13 2.5 L 5 13.5 H 11.5 L 10.5 21.5 L 19 10 H 12.5 Z',
	plug: 'M 9 3 V 8 M 15 3 V 8 M 6 8 H 18 V 11 a 6 6 0 0 1 -12 0 Z M 12 17 V 21',
	mail: 'M 3 6 H 21 V 18 H 3 Z M 3 6 L 12 13 L 21 6',
	shield: 'M 12 3 L 19 6 V 11.5 C 19 16 16 19 12 21 C 8 19 5 16 5 11.5 V 6 Z M 9 12 L 11.2 14.2 L 15.2 10',
};
---

<section class="section" id="experience">
	<SectionHead eyebrow={copy.eyebrow} title={copy.title} cite={copy.cite} />

	{
		entries.map(({ id, data }, i) => (
			<article class="job" id={id.split('/')[1]}>
				<header class="job-head">
					{data.logo ? (
						<a class="logo has-img" href={data.url} tabindex="-1" aria-hidden="true">
							<img src={data.logo} alt="" />
						</a>
					) : (
						<span class="logo" aria-hidden="true">
							{data.mark ?? data.org.slice(0, 3)}
						</span>
					)}
					<div class="job-title">
						<span class="num">{pad(i + 1)}</span>
						<h3>{data.url ? <a href={data.url}>{data.org}</a> : data.org}</h3>
						<p class="role">{data.role}</p>
					</div>
					<p class="when">
						{data.period}
						<br />
						<span>{data.place}</span>
					</p>
				</header>

				<div class="job-body">
					<p class="summary" set:html={inline(data.summary)} />
					{data.tags.length > 0 && (
						<ul class="tags">
							{data.tags.map((tag) => (
								<li>{tag}</li>
							))}
						</ul>
					)}

					<Gallery photos={data.photos} />

					{data.highlights.map((h, j) => (
						<div class="highlight" id={`${id.split('/')[1]}-${j + 1}`}>
							<p class="h-label">
								<span>
									{i + 1}.{j + 1}
								</span>
								{h.label}
							</p>
							<h4>{h.title}</h4>
							{h.summary && <p class="h-summary" set:html={inline(h.summary)} />}
							{h.diagram === 'pytrobot' && <Pytrobot />}
							{h.diagram === 'fiscal' && <Fiscal />}
							{h.diagram === 'plataforma' && <Plataforma />}
							{h.bullets.length > 0 && (
								<ul class="bullets">
									{h.bullets.map((b) =>
										typeof b === 'string' ? (
											<li set:html={inline(b)} />
										) : (
											<li class="has-gain">
												<span class="gain">
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<path d={gainIcons[b.icon]} />
													</svg>
													{b.gain}
												</span>
												<span set:html={inline(b.text)} />
											</li>
										),
									)}
								</ul>
							)}
							{h.links.length > 0 && (
								<p class="h-links">
									{h.links.map((l) => (
										<a class="text-link" href={l.href}>
											{l.text}
										</a>
									))}
								</p>
							)}
						</div>
					))}

					{data.footnote && <p class="footnote" set:html={inline(data.footnote)} />}
				</div>
			</article>
		))
	}
</section>

<style>
	.job + .job {
		margin-top: clamp(4rem, 8vw, 6rem);
	}

	.job-head {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 2.25rem;
		padding-block: 2.5rem;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.logo {
		display: grid;
		place-items: center;
		width: 6.5rem;
		height: 6.5rem;
		background: var(--ink);
		color: var(--bg);
		font-family: var(--mono);
		font-size: 1.1rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	/* Logo de verdade (campo "logo"): sem o quadrado escuro, só a imagem contida no espaço. */
	.logo.has-img {
		background: none;
	}

	.logo.has-img img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.num {
		font-family: var(--mono);
		font-size: 0.85rem;
		color: var(--accent);
	}

	h3 {
		margin-top: 0.4rem;
		font-size: clamp(2.4rem, 5vw, 4rem);
		letter-spacing: -0.035em;
	}

	h3 a {
		text-decoration: none;
	}

	h3 a:hover {
		color: var(--accent);
	}

	.h-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.75rem;
		margin-top: 1.75rem;
	}

	.footnote {
		margin-top: 2rem;
		padding-left: 1rem;
		border-left: 2px solid var(--mark);
		max-width: 52rem;
		font-family: var(--mono);
		font-size: 0.8rem;
		line-height: 1.7;
		color: var(--muted);
	}

	.role {
		margin-top: 0.75rem;
		font-family: var(--mono);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.when {
		align-self: start;
		text-align: right;
		font-family: var(--mono);
		font-size: 0.85rem;
		line-height: 1.8;
		color: var(--ink-soft);
	}

	.when span {
		color: var(--muted);
	}

	.job-body {
		padding-left: calc(6.5rem + 2.25rem);
		padding-top: 2.5rem;
	}

	.summary {
		max-width: 52rem;
		font-size: clamp(1.15rem, 1.8vw, 1.35rem);
		line-height: 1.65;
		color: var(--ink-soft);
	}

	.tags {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		margin-top: 2rem;
		padding: 0;
	}

	.tags li {
		padding: 0.6rem 1rem;
		border: 1px solid var(--line);
		font-family: var(--mono);
		font-size: 0.78rem;
		color: var(--ink-soft);
	}

	.tags li + li {
		border-left: 0;
	}

	.highlight {
		margin-top: 3rem;
		padding: clamp(1.5rem, 3vw, 2.75rem);
		border: 1px solid var(--line);
		background: var(--surface);
	}

	.highlight + .highlight {
		margin-top: 1.5rem;
	}

	.h-label {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 2rem;
		font-family: var(--mono);
		font-size: 0.8rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.h-label span {
		color: var(--accent);
	}

	h4 {
		margin-top: 1.25rem;
		font-size: clamp(1.6rem, 3vw, 2.25rem);
		line-height: 1.15;
	}

	.h-summary {
		margin-top: 1.25rem;
		max-width: 50rem;
		color: var(--muted);
	}

	.bullets {
		list-style: none;
		margin-top: 2rem;
		padding: 0;
		border-top: 1px dotted var(--line);
	}

	.bullets li {
		position: relative;
		padding: 1.1rem 0 1.1rem 2rem;
		border-bottom: 1px dotted var(--line);
		line-height: 1.6;
	}

	.bullets li:last-child {
		border-bottom: 0;
	}

	.bullets li::before {
		content: '↳';
		position: absolute;
		left: 0;
		color: var(--accent);
	}

	/* Item com ganho: o ganho, com ícone, numa coluna à esquerda no lugar da seta. */
	.bullets li.has-gain {
		display: grid;
		grid-template-columns: 12.5rem 1fr;
		align-items: baseline;
		gap: 1.25rem;
		padding-left: 0;
	}

	.bullets li.has-gain::before {
		content: none;
	}

	.gain {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-family: var(--mono);
		font-size: 0.88rem;
		font-weight: 500;
		line-height: 1.3;
		color: var(--accent);
	}

	.gain svg {
		flex: none;
		width: 1.3rem;
		height: 1.3rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	@media (max-width: 760px) {
		.bullets li.has-gain {
			grid-template-columns: 1fr;
			gap: 0.4rem;
		}

		.job-head {
			grid-template-columns: auto 1fr;
			gap: 1.25rem;
		}

		.logo {
			width: 4rem;
			height: 4rem;
			font-size: 0.8rem;
		}

		.when {
			grid-column: 1 / -1;
			text-align: left;
		}

		.job-body {
			padding-left: 0;
		}
	}
</style>
