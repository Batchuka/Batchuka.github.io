---
/* 01 Experiência: um bloco por entrada de src/content/experience/<idioma>/, com cartões numerados. */
import { getCollection } from 'astro:content';
import { home } from '../data/home';
import { getLangFromUrl } from '../i18n/ui';
import Gallery from './Gallery.astro';
import SectionHead from './SectionHead.astro';

const lang = getLangFromUrl(Astro.url);
const copy = home[lang].experience;
const entries = (
	await getCollection('experience', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft)
).sort((a, b) => a.data.order - b.data.order);
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="section" id="experience">
	<SectionHead eyebrow={copy.eyebrow} title={copy.title} lead={copy.lead} />

	{
		entries.map(({ id, data }, i) => (
			<article class="job" id={id.split('/')[1]}>
				<header class="job-head">
					<span class="logo" aria-hidden="true">
						{data.mark ?? data.org.slice(0, 3)}
					</span>
					<div class="job-title">
						<span class="num">{pad(i + 1)}</span>
						<h3>{data.url ? <a href={data.url}>{data.org}</a> : data.org}</h3>
						<p class="role">{data.role}</p>
					</div>
					<p class="when">
						{data.period}
						<br />
						<span>{data.place}</span>
					</p>
				</header>

				<div class="job-body">
					<p class="summary">{data.summary}</p>
					{data.tags.length > 0 && (
						<ul class="tags">
							{data.tags.map((tag) => (
								<li>{tag}</li>
							))}
						</ul>
					)}

					<Gallery photos={data.photos} />

					{data.highlights.map((h, j) => (
						<div class="highlight">
							<p class="h-label">
								<span>
									{i + 1}.{j + 1}
								</span>
								{h.label}
							</p>
							<h4>{h.title}</h4>
							{h.summary && <p class="h-summary">{h.summary}</p>}
							{h.bullets.length > 0 && (
								<ul class="bullets">
									{h.bullets.map((b) => (
										<li>{b}</li>
									))}
								</ul>
							)}
							{h.links.length > 0 && (
								<p class="h-links">
									{h.links.map((l) => (
										<a class="text-link" href={l.href}>
											{l.text}
										</a>
									))}
								</p>
							)}
						</div>
					))}

					{data.footnote && <p class="footnote">{data.footnote}</p>}
				</div>
			</article>
		))
	}
</section>

<style>
	.job + .job {
		margin-top: clamp(4rem, 8vw, 6rem);
	}

	.job-head {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 2.25rem;
		padding-block: 2.5rem;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.logo {
		display: grid;
		place-items: center;
		width: 6.5rem;
		height: 6.5rem;
		background: var(--ink);
		color: var(--bg);
		font-family: var(--mono);
		font-size: 1.1rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.num {
		font-family: var(--mono);
		font-size: 0.85rem;
		color: var(--accent);
	}

	h3 {
		margin-top: 0.4rem;
		font-size: clamp(2.4rem, 5vw, 4rem);
		letter-spacing: -0.035em;
	}

	h3 a {
		text-decoration: none;
	}

	h3 a:hover {
		color: var(--accent);
	}

	.h-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.75rem;
		margin-top: 1.75rem;
	}

	.footnote {
		margin-top: 2rem;
		padding-left: 1rem;
		border-left: 2px solid var(--mark);
		max-width: 52rem;
		font-family: var(--mono);
		font-size: 0.8rem;
		line-height: 1.7;
		color: var(--muted);
	}

	.role {
		margin-top: 0.75rem;
		font-family: var(--mono);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.when {
		align-self: start;
		text-align: right;
		font-family: var(--mono);
		font-size: 0.85rem;
		line-height: 1.8;
		color: var(--ink-soft);
	}

	.when span {
		color: var(--muted);
	}

	.job-body {
		padding-left: calc(6.5rem + 2.25rem);
		padding-top: 2.5rem;
	}

	.summary {
		max-width: 52rem;
		font-size: clamp(1.15rem, 1.8vw, 1.35rem);
		line-height: 1.65;
		color: var(--ink-soft);
	}

	.tags {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		margin-top: 2rem;
		padding: 0;
	}

	.tags li {
		padding: 0.6rem 1rem;
		border: 1px solid var(--line);
		font-family: var(--mono);
		font-size: 0.78rem;
		color: var(--ink-soft);
	}

	.tags li + li {
		border-left: 0;
	}

	.highlight {
		margin-top: 3rem;
		padding: clamp(1.5rem, 3vw, 2.75rem);
		border: 1px solid var(--line);
		background: var(--surface);
	}

	.highlight + .highlight {
		margin-top: 1.5rem;
	}

	.h-label {
		display: flex;
		gap: 2rem;
		font-family: var(--mono);
		font-size: 0.8rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.h-label span {
		color: var(--accent);
	}

	h4 {
		margin-top: 1.25rem;
		font-size: clamp(1.6rem, 3vw, 2.25rem);
		line-height: 1.15;
	}

	.h-summary {
		margin-top: 1.25rem;
		max-width: 50rem;
		color: var(--muted);
	}

	.bullets {
		list-style: none;
		margin-top: 2rem;
		padding: 0;
		border-top: 1px dotted var(--line);
	}

	.bullets li {
		position: relative;
		padding: 1.1rem 0 1.1rem 2rem;
		border-bottom: 1px dotted var(--line);
		line-height: 1.6;
	}

	.bullets li:last-child {
		border-bottom: 0;
	}

	.bullets li::before {
		content: '↳';
		position: absolute;
		left: 0;
		color: var(--accent);
	}

	@media (max-width: 760px) {
		.job-head {
			grid-template-columns: auto 1fr;
			gap: 1.25rem;
		}

		.logo {
			width: 4rem;
			height: 4rem;
			font-size: 0.8rem;
		}

		.when {
			grid-column: 1 / -1;
			text-align: left;
		}

		.job-body {
			padding-left: 0;
		}
	}
</style>
