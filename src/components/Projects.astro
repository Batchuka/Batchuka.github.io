---
/*
 * 02 Projetos: entradas de src/content/projects/<idioma>/, separadas pelo campo "group".
 * Produto e laboratório aparecem em lista grande; "other" aparece numa grade compacta.
 */
import { getCollection } from 'astro:content';
import { home } from '../data/home';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import SectionHead from './SectionHead.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const copy = home[lang].projects;
const all = (
	await getCollection('projects', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft)
).sort((a, b) => a.data.order - b.data.order);
const groups = (['product', 'lab', 'other'] as const)
	.map((key) => ({ key, ...copy.groups[key], items: all.filter((p) => p.data.group === key) }))
	.filter((g) => g.items.length > 0);
---

<section class="section" id="projects">
	<SectionHead eyebrow={copy.eyebrow} title={copy.title} lead={copy.lead} />

	{
		groups.map((g) => (
			<div class={`group group-${g.key}`}>
				<header class="group-head">
					<h3 class="eyebrow">{g.title}</h3>
					{g.lead && <p>{g.lead}</p>}
				</header>

				<ol class="list">
					{g.items.map(({ data }, i) => (
						<li>
							<span class="num">{String(i + 1).padStart(2, '0')}</span>
							<div class="body">
								<h4>
									<a href={data.url}>{data.title}</a>
									<span class="kind">{data.kind}</span>
								</h4>
								<p class="summary">{data.summary}</p>
								<p class="stack">{data.stack.join(' · ')}</p>
							</div>
							<a class="open" href={data.url} aria-hidden="true" tabindex="-1">
								{t('link.open')} ↗
							</a>
						</li>
					))}
				</ol>
			</div>
		))
	}

	<p class="all">
		<a class="text-link" href={copy.all.href}>{copy.all.text}</a>
	</p>
</section>

<style>
	.group + .group {
		margin-top: clamp(3.5rem, 7vw, 5.5rem);
	}

	.group-head {
		display: grid;
		gap: 0.9rem;
		margin-bottom: 1.5rem;
	}

	.group-head h3 {
		color: var(--accent);
	}

	.group-head p {
		max-width: 46rem;
		color: var(--muted);
	}

	.list {
		list-style: none;
		padding: 0;
		border-top: 1px solid var(--line);
	}

	li {
		display: grid;
		grid-template-columns: 6rem 1fr auto;
		gap: 1rem;
		padding-block: 2.5rem;
		border-bottom: 1px solid var(--line);
	}

	.num {
		padding-top: 0.6rem;
		font-family: var(--mono);
		font-size: 0.8rem;
		color: var(--muted);
	}

	h4 {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.4rem 1.1rem;
		font-size: clamp(2rem, 3.6vw, 2.75rem);
		letter-spacing: -0.03em;
	}

	h4 a {
		text-decoration: none;
	}

	h4 a:hover {
		color: var(--accent);
	}

	.kind {
		font-family: var(--mono);
		font-size: 0.8rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.summary {
		margin-top: 1.25rem;
		max-width: 52rem;
		color: var(--muted);
	}

	.stack {
		margin-top: 1.1rem;
		font-family: var(--mono);
		font-size: 0.8rem;
		color: var(--muted);
	}

	.open {
		padding-top: 0.6rem;
		font-size: 1rem;
		color: var(--ink);
		text-decoration: none;
		white-space: nowrap;
	}

	.open:hover {
		color: var(--accent);
	}

	/* Repositórios avulsos: grade compacta de duas colunas. */
	.group-other .list {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		column-gap: clamp(2rem, 4vw, 3.5rem);
		border-top: 0;
	}

	.group-other li {
		grid-template-columns: 1fr;
		padding-block: 1.6rem;
		border-top: 1px solid var(--line);
		border-bottom: 0;
	}

	.group-other .num,
	.group-other .open {
		display: none;
	}

	.group-other h4 {
		font-size: 1.5rem;
		letter-spacing: -0.01em;
	}

	.group-other .summary {
		margin-top: 0.6rem;
		font-size: 1rem;
	}

	.group-other .stack {
		margin-top: 0.6rem;
		font-size: 0.75rem;
	}

	.all {
		margin-top: 3rem;
	}

	@media (max-width: 760px) {
		li {
			grid-template-columns: 1fr;
			padding-block: 2rem;
		}

		.num,
		.open {
			padding-top: 0;
		}

		.open {
			display: none;
		}

		.group-other .list {
			grid-template-columns: 1fr;
		}
	}
</style>
