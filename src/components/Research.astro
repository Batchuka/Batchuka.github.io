---
/*
 * 03 Pesquisa e formação: entradas de src/content/education/<idioma>/, seguidas dos eventos,
 * cursos livres e idiomas de src/data/events.ts.
 */
import { getCollection } from 'astro:content';
import { courses, events, languages } from '../data/events';
import { home } from '../data/home';
import { getLangFromUrl } from '../i18n/ui';
import Gallery from './Gallery.astro';
import SectionHead from './SectionHead.astro';

const lang = getLangFromUrl(Astro.url);
const copy = home[lang].research;
const items = (
	await getCollection('education', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft)
).sort((a, b) => a.data.order - b.data.order);
const month = (d: string) => {
	const [y, m] = d.split('-');
	return `${m}/${y}`;
};
---

<section class="section" id="research">
	<SectionHead eyebrow={copy.eyebrow} title={copy.title} lead={copy.lead} />

	<ol class="items">
		{
			items.map(({ data }) => (
				<li>
					<p class="meta">
						<span class="kind">{data.kind}</span>
						<span>{data.period}</span>
					</p>
					<div class="body">
						<h3>{data.title}</h3>
						<p class="place">{data.place}</p>
						<p class="summary">{data.summary}</p>
						{data.bullets.length > 0 && (
							<ul class="bullets">
								{data.bullets.map((b) => (
									<li>{b}</li>
								))}
							</ul>
						)}
						{data.links.length > 0 && (
							<p class="links">
								{data.links.map((l) => (
									<a class="text-link" href={l.href}>
										{l.text}
									</a>
								))}
							</p>
						)}
						<Gallery photos={data.photos} />
					</div>
				</li>
			))
		}
	</ol>

	<h3 class="eyebrow sub">{copy.events}</h3>
	<ul class="events">
		{
			events.map((e) => (
				<li>
					<span class="date">{month(e.date)}</span>
					<span class="role">{e.role[lang]}</span>
					<span class="what">
						{e.title[lang]}
						<span class="where">{e.event[lang]}</span>
					</span>
				</li>
			))
		}
	</ul>

	<dl class="extra">
		<div>
			<dt class="eyebrow">{courses.label[lang]}</dt>
			<dd>{courses.text[lang]}</dd>
		</div>
		<div>
			<dt class="eyebrow">{languages.label[lang]}</dt>
			<dd>{languages.text[lang]}</dd>
		</div>
	</dl>

	<p class="lattes">
		<a class="text-link" href={copy.lattes.href}>{copy.lattes.text}</a>
	</p>
</section>

<style>
	.items {
		list-style: none;
		padding: 0;
		border-top: 1px solid var(--line);
	}

	.items > li {
		display: grid;
		grid-template-columns: 14rem 1fr;
		gap: 1rem 2rem;
		padding-block: 2.5rem;
		border-bottom: 1px solid var(--line);
	}

	.meta {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding-top: 0.5rem;
		font-family: var(--mono);
		font-size: 0.78rem;
		color: var(--muted);
	}

	.kind {
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent);
	}

	h3 {
		font-size: clamp(1.8rem, 3.2vw, 2.5rem);
		line-height: 1.1;
		letter-spacing: -0.025em;
	}

	.place {
		margin-top: 0.6rem;
		font-family: var(--mono);
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.summary {
		margin-top: 1.1rem;
		max-width: 50rem;
		color: var(--ink-soft);
	}

	.bullets {
		list-style: none;
		margin-top: 1.25rem;
		padding: 0;
	}

	.bullets li {
		position: relative;
		max-width: 50rem;
		padding: 0.5rem 0 0.5rem 2rem;
		color: var(--muted);
	}

	.bullets li::before {
		content: '↳';
		position: absolute;
		left: 0;
		color: var(--accent);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.75rem;
		margin-top: 1.25rem;
	}

	.sub {
		margin-top: clamp(3.5rem, 7vw, 5rem);
		margin-bottom: 1.25rem;
		font-family: var(--mono);
		font-size: 0.8rem;
		color: var(--accent);
	}

	.events {
		list-style: none;
		padding: 0;
		border-top: 1px solid var(--line);
	}

	.events li {
		display: grid;
		grid-template-columns: 6rem 12rem 1fr;
		gap: 0.4rem 1.5rem;
		padding-block: 1.25rem;
		border-bottom: 1px solid var(--line);
		font-size: 1rem;
	}

	.date,
	.role {
		font-family: var(--mono);
		font-size: 0.78rem;
		padding-top: 0.2rem;
		color: var(--muted);
	}

	.what {
		color: var(--ink-soft);
	}

	.where {
		display: block;
		margin-top: 0.2rem;
		font-size: 0.9rem;
		color: var(--muted);
	}

	.extra {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 2rem;
		margin: 3rem 0 0;
	}

	.extra dd {
		margin: 0.75rem 0 0;
		color: var(--muted);
	}

	.lattes {
		margin-top: 2.5rem;
	}

	@media (max-width: 760px) {
		.items > li,
		.events li,
		.extra {
			grid-template-columns: 1fr;
		}

		.meta {
			flex-direction: row;
			gap: 1rem;
			padding-top: 0;
		}
	}
</style>
