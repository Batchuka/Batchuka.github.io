---
/*
 * 02 Pesquisa e formação: entradas de src/content/education/<idioma>/, seguidas dos eventos,
 * de src/data/events.ts.
 */
import { getCollection } from 'astro:content';
import { events } from '../data/events';
import { home } from '../data/home';
import { getLangFromUrl } from '../i18n/ui';
import { inline } from '../utils/inline';
import Gallery from './Gallery.astro';
import SectionHead from './SectionHead.astro';

const lang = getLangFromUrl(Astro.url);
const copy = home[lang].research;
const items = (
	await getCollection('education', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft)
).sort((a, b) => a.data.order - b.data.order);
/* Subprodutos de cada formação, buscados pelo nome do arquivo em projects/<idioma>/. */
const projects = await getCollection('projects', (e) => e.id.startsWith(`${lang}/`));
const byId = new Map(projects.map((p) => [p.id.split('/')[1], p.data]));
const month = (d: string) => {
	const [y, m] = d.split('-');
	return `${m}/${y}`;
};
---

<section class="section" id="research">
	<SectionHead eyebrow={copy.eyebrow} title={copy.title} cite={copy.cite} />

	<ol class="items">
		{
			items.map(({ data }) => (
				<li>
					<p class="meta">
						<span class="kind">{data.kind}</span>
						<span>{data.period}</span>
					</p>
					<div class="body">
						<h3>{data.title}</h3>
						<p class="place">{data.place}</p>
						<p class="summary">{data.summary}</p>
						{data.bullets.length > 0 && (
							<ul class="bullets">
								{data.bullets.map((b) => (
									<li>{b}</li>
								))}
							</ul>
						)}
						{data.links.length > 0 && (
							<p class="links">
								{data.links.map((l) => (
									<a class="text-link" href={l.href}>
										{l.text}
									</a>
								))}
							</p>
						)}
						{data.projects.length > 0 && (
							<div class="byproducts">
								<p class="eyebrow">{copy.byproducts}</p>
								<ul>
									{data.projects
										.map((id) => byId.get(id))
										.filter((p) => p !== undefined)
										.map((p) => (
											<li>
												<h4>
													<a href={p.url}>{p.title}</a>
													<span class="bp-kind">{p.kind}</span>
												</h4>
												<p class="bp-summary" set:html={inline(p.summary)} />
												<p class="bp-stack">{p.stack.join(' · ')}</p>
											</li>
										))}
								</ul>
							</div>
						)}
						<Gallery photos={data.photos} />
					</div>
				</li>
			))
		}
	</ol>

	<h3 class="eyebrow sub">{copy.events}</h3>
	<ul class="events">
		{
			events.map((e) => (
				<li>
					<span class="date">{month(e.date)}</span>
					<span class="role">{e.role[lang]}</span>
					<span class="what">
						{e.title[lang]}
						<span class="where">{e.event[lang]}</span>
					</span>
				</li>
			))
		}
	</ul>

</section>

<style>
	/* Subprodutos da formação: grade compacta de duas colunas. */
	.byproducts {
		margin-top: 2.5rem;
	}

	.byproducts .eyebrow {
		color: var(--accent);
	}

	.byproducts ul {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		column-gap: clamp(2rem, 4vw, 3.5rem);
		margin-top: 1rem;
		padding: 0;
	}

	.byproducts li {
		padding-block: 1.4rem;
		border-top: 1px solid var(--line);
	}

	.byproducts h4 {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.3rem 0.9rem;
		font-size: 1.4rem;
	}

	.byproducts h4 a {
		text-decoration: none;
	}

	.byproducts h4 a:hover {
		color: var(--accent);
	}

	.bp-kind {
		font-family: var(--mono);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.bp-summary {
		margin-top: 0.5rem;
		font-size: 1rem;
		color: var(--muted);
	}

	.bp-stack {
		margin-top: 0.5rem;
		font-family: var(--mono);
		font-size: 0.75rem;
		color: var(--muted);
	}

	@media (max-width: 760px) {
		.byproducts ul {
			grid-template-columns: 1fr;
		}
	}

	.items {
		list-style: none;
		padding: 0;
		border-top: 1px solid var(--line);
	}

	.items > li {
		display: grid;
		grid-template-columns: 14rem 1fr;
		gap: 1rem 2rem;
		padding-block: 2.5rem;
		border-bottom: 1px solid var(--line);
	}

	.meta {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding-top: 0.5rem;
		font-family: var(--mono);
		font-size: 0.78rem;
		color: var(--muted);
	}

	.kind {
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent);
	}

	h3 {
		font-size: clamp(1.8rem, 3.2vw, 2.5rem);
		line-height: 1.1;
		letter-spacing: -0.025em;
	}

	.place {
		margin-top: 0.6rem;
		font-family: var(--mono);
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.summary {
		margin-top: 1.1rem;
		max-width: 50rem;
		color: var(--ink-soft);
	}

	.bullets {
		list-style: none;
		margin-top: 1.25rem;
		padding: 0;
	}

	.bullets li {
		position: relative;
		max-width: 50rem;
		padding: 0.5rem 0 0.5rem 2rem;
		color: var(--muted);
	}

	.bullets li::before {
		content: '↳';
		position: absolute;
		left: 0;
		color: var(--accent);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.75rem;
		margin-top: 1.25rem;
	}

	.sub {
		margin-top: clamp(3.5rem, 7vw, 5rem);
		margin-bottom: 1.25rem;
		font-family: var(--mono);
		font-size: 0.8rem;
		color: var(--accent);
	}

	.events {
		list-style: none;
		padding: 0;
		border-top: 1px solid var(--line);
	}

	.events li {
		display: grid;
		grid-template-columns: 6rem 12rem 1fr;
		gap: 0.4rem 1.5rem;
		padding-block: 1.25rem;
		border-bottom: 1px solid var(--line);
		font-size: 1rem;
	}

	/* O último evento fica sem borda: a linha de cima da seção seguinte já fecha a lista. */
	.events li:last-child {
		border-bottom: 0;
	}

	.date,
	.role {
		font-family: var(--mono);
		font-size: 0.78rem;
		padding-top: 0.2rem;
		color: var(--muted);
	}

	.what {
		color: var(--ink-soft);
	}

	.where {
		display: block;
		margin-top: 0.2rem;
		font-size: 0.9rem;
		color: var(--muted);
	}

	@media (max-width: 760px) {
		.items > li,
		.events li {
			grid-template-columns: 1fr;
		}

		.meta {
			flex-direction: row;
			gap: 1rem;
			padding-top: 0;
		}
	}
</style>
