---
/* 04 Serviços: grade 2x2, cada serviço com o projeto que o demonstra. */
import { home } from '../data/home';
import { getLangFromUrl } from '../i18n/ui';
import SectionHead from './SectionHead.astro';

const lang = getLangFromUrl(Astro.url);
const copy = home[lang].services;
---

<section class="section" id="services">
	<SectionHead eyebrow={copy.eyebrow} title={copy.title} lead={copy.lead} />

	<div class="grid">
		{
			copy.items.map((s) => (
				<article>
					<h3>{s.title}</h3>
					<p>{s.text}</p>
					<a class="text-link" href={s.href}>
						{s.link} ↗
					</a>
				</article>
			))
		}
	</div>

	<p class="actions">
		<a class="text-link" href={copy.primary.href}>{copy.primary.text}</a>
		<a class="text-link soft" href={copy.secondary.href}>{copy.secondary.text}</a>
	</p>
</section>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0 clamp(2rem, 4vw, 3.5rem);
	}

	article {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.25rem;
		padding-block: 2.5rem 3rem;
		border-top: 1px solid var(--line);
	}

	h3 {
		font-size: clamp(1.6rem, 2.6vw, 2.1rem);
		line-height: 1.15;
		letter-spacing: -0.015em;
	}

	article p {
		flex: 1;
		line-height: 1.75;
		color: var(--muted);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 2.25rem;
		margin-top: 2rem;
	}

	@media (max-width: 760px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
