---
/*
 * Barra lateral fixa: marca, local, navegação numerada pelas seções e links no rodapé.
 * Em telas estreitas vira um cabeçalho no topo da página.
 */
import { site } from '../data/site';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const sections = ['experience', 'projects', 'research', 'toolbox', 'services', 'contact'] as const;
---

<aside class="sidebar">
	<a class="brand" href="#top">
		<span class="brand-mark" aria-hidden="true">{site.initial}</span>
		<span class="brand-text">
			<span class="brand-name">{site.name}</span>
			<span class="brand-role">{site.role[lang]}</span>
		</span>
	</a>
	<p class="place"><span class="dot" aria-hidden="true"></span>{site.place[lang]}</p>

	<nav class="side-nav" aria-label={lang === 'pt' ? 'Seções' : 'Sections'}>
		<ol>
			{
				sections.map((s, i) => (
					<li>
						<a href={`#${s}`} data-section={s}>
							<span class="num">{String(i + 1).padStart(2, '0')}</span>
							<span class="label">{t(`nav.${s}`)}</span>
						</a>
					</li>
				))
			}
		</ol>
	</nav>

	<div class="side-foot">
		<p class="status">{site.status[lang]}</p>
		<div class="icons">
			<a href={site.links.github} aria-label="GitHub" title="GitHub">
				<svg viewBox="0 0 16 16" aria-hidden="true">
					<path
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
			{
				site.links.linkedin && (
					<a href={site.links.linkedin} aria-label="LinkedIn" title="LinkedIn" class="in">
						in
					</a>
				)
			}
		</div>
	</div>
</aside>

<script>
	/* Destaca na navegação a seção que está no meio da tela. */
	const links = new Map<string, HTMLAnchorElement>();
	document.querySelectorAll<HTMLAnchorElement>('.side-nav a[data-section]').forEach((a) => {
		links.set(a.dataset.section!, a);
	});

	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				links.forEach((a) => a.removeAttribute('aria-current'));
				links.get(entry.target.id)?.setAttribute('aria-current', 'true');
			}
		},
		{ rootMargin: '-45% 0px -50% 0px' },
	);

	document.querySelectorAll('main section[id]').forEach((s) => observer.observe(s));
</script>

<style>
	.sidebar {
		position: fixed;
		inset: 0 auto 0 0;
		z-index: 10;
		width: var(--side-w);
		display: flex;
		flex-direction: column;
		padding: 3.5rem 2.25rem 2.25rem;
		background: var(--bg-side);
		border-right: 1px solid var(--line);
		overflow-y: auto;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 1.2rem;
		text-decoration: none;
	}

	.brand-mark {
		display: grid;
		place-items: center;
		flex: none;
		width: 3.75rem;
		height: 3.75rem;
		border: 1px solid var(--ink);
		font-family: var(--serif);
		font-size: 2.1rem;
		color: var(--ink-soft);
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.brand-name {
		font-family: var(--serif);
		font-size: 1.5rem;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: -0.01em;
		color: var(--ink-soft);
	}

	.brand-role {
		font-family: var(--mono);
		font-size: 0.68rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.place {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-top: 2rem;
		font-size: 1rem;
		color: var(--muted);
	}

	.dot {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent);
	}

	.side-nav {
		margin-block: auto;
		padding-block: 3rem;
	}

	.side-nav ol {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 1.6rem;
	}

	.side-nav a {
		position: relative;
		display: flex;
		align-items: baseline;
		gap: 2.2rem;
		padding-left: 0.5rem;
		text-decoration: none;
		color: var(--muted);
		transition: color 0.15s, padding 0.2s;
	}

	.num {
		width: 1.2rem;
		font-family: var(--mono);
		font-size: 0.72rem;
	}

	.label {
		font-family: var(--serif);
		font-size: 1.9rem;
		line-height: 1;
	}

	.side-nav a:hover,
	.side-nav a[aria-current='true'] {
		color: var(--ink);
	}

	.side-nav a[aria-current='true'] {
		padding-left: 1rem;
	}

	.side-nav a[aria-current='true']::before {
		content: '';
		position: absolute;
		left: -0.5rem;
		top: -0.4rem;
		bottom: -0.4rem;
		width: 2px;
		background: var(--accent);
	}

	.side-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1.6rem;
		border-top: 1px solid var(--line);
	}

	.status {
		max-width: 11rem;
		font-family: var(--mono);
		font-size: 0.68rem;
		line-height: 1.6;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.icons {
		display: flex;
		gap: 0.6rem;
	}

	.icons a {
		display: grid;
		place-items: center;
		width: 2.9rem;
		height: 2.9rem;
		border: 1px solid var(--line);
		color: var(--ink-soft);
		text-decoration: none;
		font-weight: 600;
		transition: border-color 0.15s, color 0.15s;
	}

	.icons a:hover {
		border-color: var(--ink);
		color: var(--ink);
	}

	.icons svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: currentColor;
	}

	@media (max-width: 960px) {
		.sidebar {
			position: static;
			width: auto;
			padding: 1.25rem 1rem 1rem;
			border-right: 0;
			border-bottom: 1px solid var(--line);
		}

		.brand-mark {
			width: 2.75rem;
			height: 2.75rem;
			font-size: 1.5rem;
		}

		.brand-name {
			font-size: 1.2rem;
		}

		.place {
			margin-top: 1rem;
			font-size: 0.9rem;
		}

		.side-nav {
			margin: 0;
			padding: 1.25rem 0 0.25rem;
		}

		.side-nav ol {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4rem 1.25rem;
		}

		.side-nav a {
			gap: 0.4rem;
			padding: 0;
		}

		.side-nav a[aria-current='true'] {
			padding-left: 0;
		}

		.side-nav a[aria-current='true']::before {
			display: none;
		}

		.label {
			font-size: 1.15rem;
		}

		.side-foot {
			display: none;
		}
	}
</style>
