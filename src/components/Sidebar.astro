---
/*
 * Barra lateral fixa: marca, local e navegação numerada pelas seções.
 * Em telas estreitas vira um cabeçalho no topo da página.
 */
import { site } from '../data/site';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const sections = ['experience', 'research', 'supervision', 'profile', 'contact'] as const;
---

<aside class="sidebar">
	<a class="brand" href="#top">
		<span class="brand-mark" aria-hidden="true">{site.initial}</span>
		<span class="brand-text">
			<span class="brand-name">{site.name}</span>
			<span class="brand-role">{site.role[lang]}</span>
		</span>
	</a>
	<p class="place"><span class="dot" aria-hidden="true"></span>{site.place[lang]}</p>

	<nav class="side-nav" aria-label={lang === 'pt' ? 'Seções' : 'Sections'}>
		<ol>
			{
				sections.map((s, i) => (
					<li>
						<a
							href={`#${s}`}
							data-section={s}
							data-profile-open={s === 'profile' ? '' : undefined}
						>
							<span class="num">{String(i + 1).padStart(2, '0')}</span>
							<span class="label">{t(`nav.${s}`)}</span>
						</a>
					</li>
				))
			}
		</ol>
	</nav>

</aside>

<script>
	/* Destaca na navegação a seção que está no meio da tela. */
	const links = new Map<string, HTMLAnchorElement>();
	document.querySelectorAll<HTMLAnchorElement>('.side-nav a[data-section]').forEach((a) => {
		links.set(a.dataset.section!, a);
	});

	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				links.forEach((a) => a.removeAttribute('aria-current'));
				links.get(entry.target.id)?.setAttribute('aria-current', 'true');
			}
		},
		{ rootMargin: '-45% 0px -50% 0px' },
	);

	document.querySelectorAll('main section[id]').forEach((s) => observer.observe(s));
</script>

<style>
	.sidebar {
		position: fixed;
		inset: 0 auto 0 0;
		z-index: 10;
		width: var(--side-w);
		display: flex;
		flex-direction: column;
		padding: 3.5rem 2.25rem 2.25rem;
		background: var(--bg-side);
		border-right: 1px solid var(--line);
		overflow-y: auto;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 1.2rem;
		text-decoration: none;
	}

	.brand-mark {
		display: grid;
		place-items: center;
		flex: none;
		width: 3.75rem;
		height: 3.75rem;
		border: 1px solid var(--ink);
		font-family: var(--serif);
		font-size: 2.1rem;
		color: var(--ink-soft);
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.brand-name {
		font-family: var(--serif);
		font-size: 1.5rem;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: -0.01em;
		color: var(--ink-soft);
	}

	.brand-role {
		font-family: var(--mono);
		font-size: 0.68rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.place {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-top: 2rem;
		font-size: 1rem;
		color: var(--muted);
	}

	.dot {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent);
	}

	.side-nav {
		margin-block: auto;
		padding-block: 3rem;
	}

	.side-nav ol {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 1.6rem;
	}

	.side-nav a {
		position: relative;
		display: flex;
		align-items: baseline;
		gap: 2.2rem;
		padding-left: 0.5rem;
		text-decoration: none;
		color: var(--muted);
		transition: color 0.15s, padding 0.2s;
	}

	.num {
		width: 1.2rem;
		font-family: var(--mono);
		font-size: 0.72rem;
	}

	.label {
		font-family: var(--serif);
		font-size: 1.9rem;
		line-height: 1;
	}

	.side-nav a:hover,
	.side-nav a[aria-current='true'] {
		color: var(--ink);
	}

	.side-nav a[aria-current='true'] {
		padding-left: 1rem;
	}

	.side-nav a[aria-current='true']::before {
		content: '';
		position: absolute;
		left: -0.5rem;
		top: -0.4rem;
		bottom: -0.4rem;
		width: 2px;
		background: var(--accent);
	}

	@media (max-width: 960px) {
		.sidebar {
			position: static;
			width: auto;
			padding: 1.25rem 1rem 1rem;
			border-right: 0;
			border-bottom: 1px solid var(--line);
		}

		.brand-mark {
			width: 2.75rem;
			height: 2.75rem;
			font-size: 1.5rem;
		}

		.brand-name {
			font-size: 1.2rem;
		}

		.place {
			margin-top: 1rem;
			font-size: 0.9rem;
		}

		.side-nav {
			margin: 0;
			padding: 1.25rem 0 0.25rem;
		}

		.side-nav ol {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4rem 1.25rem;
		}

		.side-nav a {
			gap: 0.4rem;
			padding: 0;
		}

		.side-nav a[aria-current='true'] {
			padding-left: 0;
		}

		.side-nav a[aria-current='true']::before {
			display: none;
		}

		.label {
			font-size: 1.15rem;
		}
	}
</style>
