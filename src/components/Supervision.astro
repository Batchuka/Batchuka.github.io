---
/*
 * 03 Atualmente: os passos do laboratório, numerados (tep-plant, monjolo, IHM), e no último a
 * pesquisa com Kubernetes: pergunta, arquitetura, resultados e o artigo para
 * baixar. Texto em src/data/supervision.ts.
 */
import { supervision } from '../data/supervision';
import { getLangFromUrl } from '../i18n/ui';
import { inline } from '../utils/inline';
import Supervisao from './diagrams/Supervisao.astro';
import SectionHead from './SectionHead.astro';

const lang = getLangFromUrl(Astro.url);
const copy = supervision[lang];
---

<section class="section" id="supervision">
	<SectionHead eyebrow={copy.eyebrow} title={copy.title} cite={copy.cite} lead={copy.lead} />

	<ol class="steps">
		{
			copy.steps.map((step, i) => (
				<li>
					<span class="num">{String(i + 1).padStart(2, '0')}</span>
					<div class="step-body">
						<h3>
							{step.icon && <img class="step-icon" src={step.icon} alt="" />}
							{step.title}
						</h3>
						<p class="step-text" set:html={inline(step.text)} />
						{step.image && (
							<figure class="shot">
								<img src={step.image.src} alt={step.image.alt} loading="lazy" />
								<figcaption>{step.image.caption}</figcaption>
							</figure>
						)}
						<p class="step-links">
							{step.links.map((l) => (
								<a class="text-link" href={l.href}>
									{l.text}
								</a>
							))}
						</p>

						{/* O último passo é a pesquisa: pergunta, arquitetura, resultados e artigo. */}
						{i === copy.steps.length - 1 && (
							<Fragment>
								<div class="intro">
									{copy.intro.map((p) => (
										<p>{p}</p>
									))}
								</div>

								<div class="figure">
									<Supervisao />
								</div>

								<div class="block">
									<h4 class="eyebrow">{copy.results.title}</h4>
									<ul class="results">
										{copy.results.items.map((r) => (
											<li>
												<strong>{r.value}</strong>
												<span>{r.text}</span>
											</li>
										))}
									</ul>
									<p class="note">{copy.results.note}</p>
								</div>

								<article class="paper">
									<p class="kicker">{copy.paper.kicker}</p>
									<h4>{copy.paper.title}</h4>
									<p class="authors">{copy.paper.authors}</p>
									<p class="venue">{copy.paper.venue}</p>
									<p class="actions">
										<a class="text-link download" href={copy.paper.download.href} download>
											{copy.paper.download.text}
										</a>
										{copy.paper.links.map((l) => (
											<a class="text-link" href={l.href}>
												{l.text}
											</a>
										))}
									</p>
								</article>
							</Fragment>
						)}
					</div>
				</li>
			))
		}
	</ol>
</section>

<style>
	/* Passos numerados, como os projetos de antes: número à esquerda, conteúdo à direita. */
	.steps {
		list-style: none;
		margin-top: 2.5rem;
		padding: 0;
		border-top: 1px solid var(--line);
	}

	.steps > li {
		display: grid;
		grid-template-columns: 5rem 1fr;
		gap: 1rem;
		padding-block: 2.5rem;
		border-bottom: 1px solid var(--line);
	}

	.steps > li:last-child {
		border-bottom: 0;
	}

	.num {
		padding-top: 0.7rem;
		font-family: var(--mono);
		font-size: 0.8rem;
		color: var(--accent);
	}

	.step-body h3 {
		display: flex;
		align-items: center;
		gap: 1rem;
		font-size: clamp(2rem, 3.6vw, 2.75rem);
		letter-spacing: -0.03em;
	}

	/* Logo do projeto (monjolo, gajeiro), da altura do título. */
	.step-icon {
		flex: none;
		width: 3.25rem;
		height: 3.25rem;
		object-fit: contain;
	}

	.step-text {
		max-width: 52rem;
		margin-top: 1rem;
		color: var(--muted);
		line-height: 1.65;
	}

	.step-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.75rem;
		margin-top: 1.25rem;
	}

	.shot {
		margin: 1.75rem 0 0;
	}

	.shot img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--line);
	}

	.shot figcaption {
		margin-top: 0.6rem;
		font-family: var(--mono);
		font-size: 0.72rem;
		color: var(--muted);
	}

	.intro {
		display: grid;
		gap: 1.25rem;
		max-width: 52rem;
		margin-top: 2.5rem;
		font-size: clamp(1.1rem, 1.6vw, 1.25rem);
		line-height: 1.65;
	}

	.figure {
		margin-top: 3rem;
		padding: clamp(1.25rem, 3vw, 2.5rem);
		border: 1px solid var(--line);
		background: var(--surface);
	}

	.block {
		margin-top: 3.5rem;
	}

	.block h4 {
		color: var(--accent);
	}

	.results {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		margin-top: 1.25rem;
		padding: 0;
		border-top: 1px solid var(--line);
	}

	.results li {
		display: grid;
		align-content: start;
		gap: 0.6rem;
		padding: 1.5rem 1.5rem 1.5rem 0;
	}

	.results li + li {
		padding-left: 1.5rem;
		border-left: 1px solid var(--line);
	}

	.results strong {
		font-family: var(--serif);
		font-size: clamp(2.4rem, 4.5vw, 3.4rem);
		font-weight: 400;
		line-height: 1;
		color: var(--ink);
	}

	.results span {
		color: var(--muted);
		line-height: 1.5;
	}

	.note {
		margin-top: 0.75rem;
		font-family: var(--mono);
		font-size: 0.8rem;
		color: var(--muted);
	}

	/* O artigo: cartão escuro, com o download em destaque. */
	.paper {
		margin-top: 3.5rem;
		padding: clamp(1.5rem, 3vw, 2.5rem);
		background: var(--card);
		color: var(--accent-ink);
	}

	.kicker {
		font-family: var(--mono);
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--mark);
	}

	.paper h4 {
		margin-top: 0.9rem;
		max-width: 46rem;
		font-size: clamp(1.6rem, 3vw, 2.3rem);
		line-height: 1.15;
		color: var(--accent-ink);
	}

	.authors {
		margin-top: 1rem;
	}

	.venue {
		margin-top: 0.3rem;
		opacity: 0.75;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1.75rem;
		margin-top: 1.75rem;
	}

	.paper .text-link {
		color: var(--accent-ink);
	}

	.paper .text-link.download {
		color: var(--mark);
	}

	.paper .text-link:hover {
		color: var(--mark);
	}

	@media (max-width: 760px) {
		.steps > li {
			grid-template-columns: 1fr;
		}

		.num {
			padding-top: 0;
		}

		.results {
			grid-template-columns: 1fr;
		}

		.results li,
		.results li + li {
			padding: 1.25rem 0;
			border-left: 0;
			border-bottom: 1px solid var(--line);
		}
	}
</style>
