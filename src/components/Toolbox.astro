---
/* 03 Ferramentas: uma linha por grupo de src/data/toolbox.ts, com as ferramentas em chips. */
import { home } from '../data/home';
import { toolbox } from '../data/toolbox';
import { getLangFromUrl } from '../i18n/ui';
import SectionHead from './SectionHead.astro';

const lang = getLangFromUrl(Astro.url);
const copy = home[lang].toolbox;
---

<section class="section" id="toolbox">
	<SectionHead eyebrow={copy.eyebrow} title={copy.title} lead={copy.lead} />

	<dl class="groups">
		{
			toolbox.map((group) => (
				<div class="group">
					<dt>{group.label[lang]}</dt>
					<dd>
						<ul>
							{group.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</dd>
				</div>
			))
		}
	</dl>
</section>

<style>
	.groups {
		margin: 0;
		border-top: 1px solid var(--line);
	}

	.group {
		display: grid;
		grid-template-columns: 16rem 1fr;
		align-items: center;
		gap: 1rem;
		padding-block: 2rem;
		border-bottom: 1px solid var(--line);
	}

	dt {
		font-family: var(--serif);
		font-size: 2rem;
		color: var(--ink);
	}

	dd {
		margin: 0;
	}

	ul {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		padding: 0;
	}

	li {
		padding: 0.6rem 1rem;
		border: 1px solid var(--line);
		background: var(--surface);
		font-family: var(--mono);
		font-size: 0.82rem;
		font-weight: 500;
		color: var(--ink);
		box-shadow: 2px 2px 0 var(--line-soft);
		transition: border-color 0.15s;
	}

	li:hover {
		border-color: var(--accent);
	}

	@media (max-width: 760px) {
		.group {
			grid-template-columns: 1fr;
		}

		dt {
			font-size: 1.6rem;
		}
	}
</style>
