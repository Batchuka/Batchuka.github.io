---
import '../styles/global.css';
import LangSwitch from '../components/LangSwitch.astro';
import Sidebar from '../components/Sidebar.astro';
import { getLangFromUrl, translatePath, useTranslations } from '../i18n/ui';

interface Props {
	title?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title = t('site.title') } = Astro.props;
const fonts =
	'https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500' +
	'&family=Newsreader:opsz,wght@6..72,400;6..72,500' +
	'&family=Source+Sans+3:wght@400;500;600&display=swap';
---

<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={t('site.description')} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="alternate" hreflang="pt-BR" href={new URL(translatePath(Astro.url, 'pt'), Astro.site)} />
		<link rel="alternate" hreflang="en" href={new URL(translatePath(Astro.url, 'en'), Astro.site)} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href={fonts} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="page">
			<Sidebar />
			<LangSwitch />
			<main class="content">
				<slot />
			</main>
		</div>
	</body>
</html>
